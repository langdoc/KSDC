    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orth(orig)T"
        PARENT_REF="ref@RIJ1944f" PARTICIPANT="RIJ1944f" TIER_ID="orth(orig)@RIJ1944f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>КОАЛЛЭШ КА̄НҌЦ!¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Тэдта моджесь тыгквэнҍ кырьй векяһт тыйе кэжьнэгэ мӣлльтэ тӣввтхэ тӣн те̄дэтҍ Куэллнэгк нёарк таввял ваннҍ ва̄ннтас на̄рэд баяс - сааме баяс.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Мушштҍебпе, манҍтэ мӯр, мӯррья я суӣн шэннтэв мӣнн па̄јјхэсьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a17" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Уһцбэдтӭ я чӣннбэдтӭ са̄мь нэммдмужэтҍ: ёгэнҍ, ёавьрэнҍ, поакенҍ, мерэнҍ, куленҍ, ноавьтэнҍ, лоантэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Тӯййшэ тэнна кырьй мӣлльтэ вуайй о̄ххтант, коанҍцэгуэййм я ро̄дҍхэлегуэйм.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Тыйе, канҍц, быдт эфт вуййк отҍхуж нилье аннтмэнч отҍхужэнҍ воалшэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Пӯррь томтаслуввмушш тыйе, парнэ, са̄мь энциклопедияйенҍ.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>кырьйхэй Увван Ро̄за Яковлева</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orthT"
        PARENT_REF="ref@RIJ1944f" PARTICIPANT="RIJ1944f" TIER_ID="orth@RIJ1944f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Коа̄ллэш ка̄нҍц!¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Тэдта мо̄джесь тыгквэнҍ кыррьй ве̄кяһт тыйе кэжьнэгэ мӣлльтэ тӣввтхэ тӣн те̄дэтҍ Куэллнэгк нёа̄рк таввял ва̄ннҍ ва̄ннтас на̄рэд баяс — соа̄ме баяс.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a13" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Мушштъебпе, манҍтэ мӯр, муэрья я суйн шэ̄ннтэв мӣн па̄ҋкесьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Уһцбэдтӭ я чӣннбэдтӭ са̄мь нэммдмужэтҍ: ёгэнҍ, ёа̄вьрэнҍ, поакенҍ, ме̄рэнҍ, кӯленҍ, ноа̄вьтэнҍ, лоанҍтэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a23" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Тӯййшэ тэнна кырьй мӣлльтэ вуайй о̄ххтант, коа̄нҍцэгуэйм я ро̄дҍхэлегуэйм.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Тыйе, ка̄нҍц, быдт эфт вуййк отҍхуж нилье аннтмэньч отҍхужэнҍ воалшэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Пӯррь томтаслуввмушш тыйе, парнэ, са̄мь энциклопедҍяенҍ.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>кырьйхэй Увван Ро̄за Яковлева</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="rus" LINGUISTIC_TYPE_REF="ft-rus(orig)T"
        PARENT_REF="orth@RIJ1944f" PARTICIPANT="RIJ1944f" TIER_ID="ft-rus(orig)@RIJ1944f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ДОРОГИЕ ДРУЗЬЯ!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a9" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Эта красивая удивительная книга поможет вам по вопросам пополнить ваши знания о коренном северном народе Кольского полуострова – саами.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Вспомните, какие деревья, ягоды и травы растут в нашем крае.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a19" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Узнаете саамские названия рек, озер, гор, морей, рыб, животных, птиц.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Заниматься по этой книге можно по-одному, с друзьями, с родителями.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a29" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Вам, друзья, нужно из четырех ответов выбрать один.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Доброго вам знакомства, ребята, с саамской энциклопедией.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>автор Яковлева Роза Ивановна</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
