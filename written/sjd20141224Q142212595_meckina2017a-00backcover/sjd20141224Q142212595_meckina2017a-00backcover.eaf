    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orth(orig)T"
        PARENT_REF="ref@JIM1934f" PARTICIPANT="JIM1934f" TIER_ID="orth(orig)@JIM1934f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Кӣча, ко̄ххт па̄ррна вӯллькэв вуаӈӈкэ, тэсьтханна мун вӣжя сӣнэ мӣлльтэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Пя̄јтэсьт вӣжя, ев уйнче пэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Эмм мэ̄н сӣн вуаӈӈкэм сайя.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a13" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>А касьт - не мӣстэга туэгка луэма я тамьпе вуаӈка.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Э̄ххьтэшьт соагке пай шэ шӯрр суэввель.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Па̄ррна уйнсэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>О-хо-хо!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a17" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Кӣһче, кӣһче, па̄ррна, нийтэшка - дэдт суэввель соагэ, да оајјк суэввель.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Нэ е нӣйта!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orthT"
        PARENT_REF="ref@JIM1934f" PARTICIPANT="JIM1934f" TIER_ID="orth@JIM1934f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a19" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Кӣча, ко̄ххт па̄ррнэ вӯллькэв вуаӈӈкэ, тэсьтханна мунн вӣжя сӣнэ мӣлльтэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Пяҋтэсьт вӣжя, ев уйнче бэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a21" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Эмм мэ̄н сӣн вуаӈӈкэм сайя.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>А касьт-не мӣстэга туэгка луэма я тамьпэ вуаӈка.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a23" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Э̄ххьтэшьт соагке пай жэ шӯрр суэввель.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Па̄ррнэ уйнсэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a25" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>О-хо-хо!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Кӣһче, кӣһче, па̄ррнэ, нийтэшка-дэдт суэввель соагэ, да оаҋҋк суэввель.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Ну и нӣйта!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="sme" LINGUISTIC_TYPE_REF="ft-sme(orig)T"
        PARENT_REF="orth@JIM1934f" PARTICIPANT="JIM1934f" TIER_ID="ft-sme(orig)@JIM1934f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Go bártnit mannet iežaset oaggunsadjái, de mun viegan sin maŋis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a29" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Mun viegan suoli aman oainnáhallat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>In viega sin oaggunsadjái.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Mun čiehkádan gosa nu miestagiid duohkái ja doppe mun oakkun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Oktii mun godden stuorra soavvila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Bártnit imaštalle.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>– Oooo!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Gehččet, gehččet, bártnit, nieida lea goddán soavvila ja velába stuorrá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Gea dien nieidda!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="rus" LINGUISTIC_TYPE_REF="ft-rusT"
        PARENT_REF="orth@JIM1934f" PARTICIPANT="JIM1934f" TIER_ID="ft-rus@JIM1934f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Смотрю. Как только мальчики отправятся на ужение, я тут же бегу за ними.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Скрытно бегу, чтобы они не заметили.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Я не иду на место их ужения.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Прячусь где-нибудь в кустах и там ловлю.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Однажды я поймала большого хариуса.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Ребята увидели.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>О-хо-хо!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Смотрите, смотрите, ребята, девчонка-то поймала хариуса, да еще немаленького.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Ну и девочка!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="eng" LINGUISTIC_TYPE_REF="ft-engT"
        PARENT_REF="orth@JIM1934f" PARTICIPANT="JIM1934f" TIER_ID="ft-eng@JIM1934f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>I watch. As soon as the boys set off to go fishing, I run right after them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>I run stealthily so they won’t notice me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>I don’t go to their fishing spot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>I hide somewhere in the bushes and fish there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>One day I caught a big grayling.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>The boys saw it.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Oh-ho-ho!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Look, look, boys, the girl has caught a grayling, and a pretty big one at that.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>What a girl!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
