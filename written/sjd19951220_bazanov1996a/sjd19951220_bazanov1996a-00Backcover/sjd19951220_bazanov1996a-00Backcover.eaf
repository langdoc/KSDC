        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Со̄нн та̄т соагкэ вӣллькесь пӯдзэ я ма̄тҍхэ со̄н куллтэллэ о̄ллмэ па̄кнэмужэтҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Тэдт лы'к а̄нн пӯдзэ пынньесьт е̄ннэ вышшэлвудтэ, кӣҏшэмвуд я е̄гкьмуж.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Маӈельт пӯдзэ кэ̄рхэллъе быдт воалмаш шэ̄ннтэ югке рэ̄зэтҍ вуэҋтэ ста̄рт кя̄йн альн,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>тэнн гуэйкэ быдт соннӭ ӣджяс е̄ннэ чинндэдтэ, штобэ эле ёррэ, эле пуадтра'тӭ а̄ййк</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>я вял быдт пӯдзэ туаррье ӣжянт лоаччкэльвудэнҍ я сӯррвасвудэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Тэдта кыррьй элля лышэ тэнн баяс,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>сонн мушштал вя̄л югке пя̄ййвсэ ло̄ссесь ча̄рр о̄ллмэ робэт баэс, кӯ манн о̄ллтлэзэсьт сыйтэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Пӯдзэ пынней пуэраст тӣдтӭв ча̄рр тӯетҍ, ве̄кьхэв нӯрршэтҍ выгкэ эвтэс мадтар-а̄е юрртэтҍ я тӯетҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Чудзэтҍ карвуллэмэнҍ омпэ суткэ, Тоанла е̄ннэ мӣлле пуадт,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>мӣ со̄нэнҍ ля̄йй эввтэль, юррт ажесь нӯрр па̄ль байя, Шӯур Шаннт Е̄ммьне туар байя.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Пугк э̄ллмса юрртэ ся̄гкнэнҍ Тоанлэсьт е̄рркъя мо̄джесь са̄мь моаййнсэгуэйм.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Ӣллькъювэвв ле пугк Тоанал юрртэ, тэнн баяс быдт тыйе ӣджянт ло̄гкэ я тӣдтӭ.¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>ISBN 82-7374-300-4</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>9 788373 743008</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Tаввял Кыррьй в.а.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="deu" LINGUISTIC_TYPE_REF="ft-deuT"
        PARENT_REF="orth@NEA1937f" PARTICIPANT="NEA1937f" TIER_ID="ft-deu@NEA1937f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Askold Baschanow wurde 1934 im Ort Notosero in der Oblast Murmansk geboren.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Jetzt lebt er im Ort Rewda, ist verheiratet, und er hat zwei Kinder.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Er hat in Leningrader an der Fakultät für die kleinen Völker des Nordens am pädagagischen Institut studiert.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>In der Kindheit hat er als Rentierhirtengehilfe gearbeitet.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>Später hat er als Traktorist gearbeitet, als Elektromechaniker in einem Bergwerk und als Elektroingenieur. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>1983 erschien sein russischsprachiger Gedichtband „Sonne über der Tundra“ in Murmansk.¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Ins Kildinsamische übersetzte Nina Jelissejewna Afanassjewa.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Inhalt: „Weißes Rentier“ ist eine Novelle über einen jungen Rentierhirten.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>Über Danilka, dessen größter Wunsch es ist Sieger zu werden beim Skijöring auf dem Festival des Nordens in Murmansk.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Er möchte ein weißes Rentier einfangen und es so ausbilden, dass es auf menschliche Kommandos hört.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>Diese Aufgabe erfordert viel Einsatz vom Rentierhirten, Ausdauer und Geduld.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>Eine Fahrerin beim Skijöring muss auf ganz unterschiedliche Bedingungen auf der Rennstrecke vorbereitet sein.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Deshalb muss sie selbst viel trainieren, um nicht zu stürzen und auch keine Zeit zu verlieren.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>Und gleichzeitig muss die eigene Geschicklichkeit und Lebhaftigkeit des Rentiers aufrechterhalten werden.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Das Buch handelt nicht nur davon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>Es erzählt auch vom schweren Arbeitsalltag der Menschen in der Tundra, wie er weit entfernt von den Siedlungen stattfindet.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>Die Rentierhirten, die mit den Arbeiten in der Tundra gut vertraut sind, helfen den Jungen, das Wissen und die Traditionen der Vorfahren weiterzuführen.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Beim Hüten der Herde Tag und Nacht kommt Danilka vieles in den Sinn:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>Wie war es für ihn früher; er denkt über Vaters Jugendzeit nach, über den Großen Vaterländischen Krieg.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Alle Tagträume geraten bei Danilka mit den wunderbaren traditionellen samischen Überlieferungen durcheinander.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>Werden sich Danilkas Wünsche alle erfüllen? Das müsst ihr selbst lesen und erfahren.¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>ISBN 82-7374-300-4</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>9 788373 743008</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>Davvi Girji AG</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft-lingT" PARENT_REF="orth@NEA1937f"
        PARTICIPANT="NEA1937f" TIER_ID="ft-ling@NEA1937f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Russisch ни … ни 'weder … noch'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Pronomen unbelebt сонн</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Essiv</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>в. а. = „акционерное общество“</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
