    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orthT"
        PARENT_REF="ref@NEA1937f" PARTICIPANT="NEA1937f" TIER_ID="orth@NEA1937f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a21" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Аскольд Бажанов шэ̄ннтма лӣ 1934 ыгесьт Нӯһтҍя̄ввьр сыйтэсьт Мурманскэ обласьтэсьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Адтҍ сонн я̄лл Ре̄ввда сыйтэсьт, ноайтлэдтма лӣ я сост ле̄в кӯххьт па̄ррнэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a23" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Сонн лӣ о̄һпнуввма Ленинградэсьт педагогическэ институтэсьт Таввял ре̄ввьн о̄ллмае факультэтэсьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Па̄ррнэ па̄лесьт сонн лӣ лыһкма пӯдзэ пыннье ве̄һкенҍ,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>маӈӈа ро̄бхушшма лӣ трактористэнҍ, электромеханиканҍ рӯднигкэсьт я электромонтёррэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a25" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Сост ля̄йй выййтма 1983 ыгесьт Мурман ланӭсьт стихотворенье кыррьй «Пе̄ййв ча̄р альн» рӯшш кӣлэсьт.¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Кӣллт са̄мь кӣлле ёаркэсьт Ельцэ Нӣна Афанасьева.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>ГИРЙЙИ СИСДОАЛЛУ: «Вӣллькэсь пуаз» лӣ моайнас кырьй нӯрр пӯдзэ пынней баяс,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>Тоанла баяс, ке̄нн шурьмусс юрртэ лӣ шэ̄ннтэ вуэҋҋтъенҍ маӈельт пӯдзэ кэ̄рхэллмужэсьт шӯрр Таввял Пра̄зьнэгкесьт Мурман ланӭсьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Сонн та̄т соагкэ вӣллькэсь пӯдзэ я ма̄тҍхэ со̄н куллтэллэ о̄ллмэ па̄кнэмужэтҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a29" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Тэдт лыһк а̄нн пӯдзэ пынньесьт е̄ннэ вышшэлвудтэ, кӣҏшэмвуд я е̄гкьмуж.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Маӈельт пӯдзэ кэ̄рхэллъе быдт воа̄лмаш шэ̄ннтэ югке рэ̄зэтҍ вуэҋтэ ста̄рт кя̄йн альн,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>тэнн гуэйкэ быдт соннӭ ӣджяс е̄ннэ чинндэдтэ, штобэ эле ёррэ, эле пуадтраһтӭ а̄йк</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>я вя̄л быдт пӯдзэ туаррье ӣжянт лоа̄ччкэльвудэнҍ я сӯрвасвудэнҍ.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Тэдта кыррьй элля лышшэ тэнн баяс,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>сонн мушштал вя̄л югке пя̄ййвса ло̄ссесь ча̄рр о̄ллмэ робэт баяс, кӯ манн о̄ллтлэзэсьт сыйтэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Пӯдзэ пынней пуэраст тӣдтӭв ча̄рр тӯетҍ, ве̄кьхэв нӯрршэтҍ выгкэ эвтэс мадтар а̄е юрртэтҍ я тӯетҍ.¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Чудзэтҍ карвуллэмэнҍ о̄ммпэ суткэ, Тоанла е̄ннэ мӣлле пуадт:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>Мӣ со̄нэнҍ ля̄йй эввтэль; юррт ажесь нӯрр па̄ль байя, Шӯрр Шаннт Е̄ммне туар байя.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Пугк э̄ллмсэ юрртэ ся̄гкнэнҍ Тоанлэсьт е̄рркъя мо̄джесь са̄мь моаййнсэгуэйм.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Ӣллькъюввэв ле пугк Тоанал юрртэ, тэнн баяс быдт тыйе ӣджянт ло̄гкэ я тӣдтӭ.¶¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>ISBN 82-7374-300-4</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>9 788373 743008</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Tаввял Кыррьй в. а.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
