            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1543" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>А</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1544" ANNOTATION_REF="a340" PREVIOUS_ANNOTATION="a1543">
