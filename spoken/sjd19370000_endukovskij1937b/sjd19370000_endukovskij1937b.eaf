    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orth(orig)T"
        PARENT_REF="ref@ADD1854m" PARTICIPANT="ADD1854m" TIER_ID="orth(orig)@ADD1854m">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>koht kuht par̦n̦ p̦en̦jen̦ narodəș</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>jil̦e saam̦ narot k̦ilt sulləsț.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>jil̦l̦en̦ sıj paķ tuģk̦en̦, ej kuəstꞓ̦e nьm̦p̦ p̦iel̦l̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>a vənnas șinən̦ l̦ijjen̦ rьnt kurəșț.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>șinəșț l̦ijjen̦ vənnas k̦iassьn̦ꞓ̦ di l̦ijjen̦ țierpnьn̦ꞓ̦ koʙpa, jev kuəsțꞓ̦e rьnntə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>l̦aj arrəm p̦ejv̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>narod̦țe ʙədt șirrəd.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>tədt, modta – ej mən karvullə n̦ik̦ie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>əht par̦n̦ c̦ialk: „munn vьəlka, tol̦ke mon̦n̦e tovrus̵ ʙədt.“</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>maŋŋa nym̦p̦ par̦n̦ kovns̵uvə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>təl̦ sıj pud̦țen̦ rьnntə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>k̦ih̦ꞓ̦ev, ej kușț n̦im̦i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>maŋŋa sıj n̦ijp̦en̦ rьnntə i șirəs̵kud̦țen̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>șirəs̵kud̦țen̦ di vuajl̦ehțen̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>sir̦r̦en̦, sir̦r̦en̦, par̦n̦ taʙhuvə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>k̦iꞓ̦eșț, ꞓ̦uəl̦m̦ sama l̦ij țiv̦ț, vujjev olmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>k̦iꞓ̦eșț, kuht ꞓ̦ud̦ꞓ̦uer̦v̦ vujjev rьnntə șijje.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>par̦n̦ k̦iꞓ̦eșț togə i modta gorra, k̦iæꞓ̦, s̵tå v̦id̦ꞓ̦ed el̦l̦a koz.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>sonn voal̦tə samastr̦eləș p̦eje n̦ul i təvluvə r̦es̵kl̦ed.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>ꞓ̦ud̦ꞓ̦uer̦v̦ pajnal șiamn̦eș, pəlt parnaț; an̦ parna poaꞓ̦kəv.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>par̦n̦ p̦eje samastr̦eləș son̦n̦e ranta di lus̵tᵋ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>təl̦, ꞓ̦ud̦ꞓ̦uer̦v̦ jorə luv̦ț al̦n̦ ersajje.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>a nym̦p̦ puadt i vuəj i s̵urnant par̦n̦ əl, s̵tå munn puada, ton konᵈta, mənguəjka most tovruƶ kon̦țeh̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>par̦n̦ ap̦eț samastr̦eləș p̦ejjel̦ n̦ul i nym̦p r̦es̵k̦el̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>i tədt jorə luv̦ț al̦n̦ ersajje.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>par̦n̦ k̦iꞓ̦eșț, kașț l̦ij nym̦p̦ par̦n̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>num̦p̦ p̦iegaꞓ̦ jul̦k̦ jev kun̦ț.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>sonn, c̦ialk: «viʒ̒ rostaka palka!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>məjț jornah?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>ʙədt narod̦țe sog ləhkə».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>par̦n̦ v̦id̦ꞓ̦el̦ pajas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>a narot pugk vəsta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>tam̦ʙp̦e ujin̦es̵.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>təl̦ i v̦iƶ̦e narot pugk vəsta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>rodtjes̵ vənsədəș, vənsəț – ꞓ̦adca di suldən̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>təl̦ sugk̦es̵ i el̦k̦en̦ șin̦əț arjeguim tagkəd i kəl{d}təguim di pugk vəstən̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>n̦i əht ej kuədtjin̦ꞓ̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>olmə kuagkn̦en̦ əft sajja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>c̦iel̦k̦ev: «koht, sıj pugk pud̦țen al̦i jev pugk puadtьn̦ꞓ̦?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>c̦iel̦k̦ev: «vul̦k̦e ʙədt odcə».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>nu vot i vul̦k̦en.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>vul̦k̦en odcə olmn̦ed̦țe loģ mațț.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>a jer̦eș olmə kudtjen̦ vənsajț, a təgk vul̦k̦en̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>a șinəșț pəss jevl̦inꞓ̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>tol̦k̦e əht pəssp̦iekьn̦ꞓ̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>sıj van̦c̦en̦-von̦c̦en̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>k̦ih̦ꞓ̦ev kəskəșț pol̦țe kueșț suvv.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>vot sıj pud̦țen̦ æl̦tla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>k̦ih̦ꞓ̦ev sıj, jennəgə l̦ij olmn̦ed̦țe tamʙp̦e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>k̦ih̦ꞓ̦ev – əht.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>pud̦țen̦ æl̦tla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>sonn kəpt udt di sarn: «k̦ilt sul al̦n̦ kuəșț rup̦șeș pəlv»,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>– i sarn: «k̦iltьn̦ꞓ̦ parnaj vərr pajjan».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>təgk jev k̦irs̵ьn̦ꞓ̦, vəl̦jen̦ i rostak tvoju…</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>«mən sarnah?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>sonn k̦iꞓ̦st – təl̦ paj saam̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>sonn jur̦țəl̦, s̵tå saam̦ pud̦țen̦, s̵tå son narot el̦l̦a jil̦m̦en̦.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>sonn v̦irəșț udt, pul̦l̦ej v̦ilka ojk̦e n̦ialma i təin̦ rohpad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="sjd" LINGUISTIC_TYPE_REF="orthT"
        PARENT_REF="ref@ADD1854m" PARTICIPANT="ADD1854m" TIER_ID="orth@ADD1854m">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Коххт кӯххьт па̄рьн пыннҍенҍ нарэдэсь.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>Ӣле са̄мь нарэдт кӣллт сӯллэсьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Ӣлленҍ сыйй па̄кь тӯгкенҍ, эйй куэстче ныммьп пе̄лль.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>А вэ̄ннас сӣнэнҍ лӣйенҍ рынт гурэсьт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Сӣнэсьт лӣйенҍ вэ̄ннас кя̄ссэньч ди лӣйенҍ те̄ҏпнэньч коабпа, е̄в куэстче рыннҍтэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>Ля̄йй оаррэм пе̄ййв.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Нарэдтӭ быдт сӣррэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>Тэдт, мудта – эйй мэ̄н карвуллэ ни ке̄.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Эххт па̄рьн ця̄ӆӆк: «Мунн вуэлка, толькэ мыннӭ тоа̄авврэшш быдт.»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>Маӈӈа нымьп па̄рьн коаввнсувэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Тэль сыйй пӯдтӭнҍ рыннҍтэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>Кӣһчев, эйй кӯсьт ни мӣ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>Маӈӈа сыйй нӣййпенҍ рыннҍтэ и сӣрэшкудтӭнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>Сӣрэшкудтӭнҍ ди вуаййлэһтӭнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Сӣрренҍ-сӣрренҍ, па̄рьн та̄бхувэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Кӣчесьт, чуэлльм сама лӣ тӣввт, вӯйев о̄ллмэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>Кӣчесьт, кӯһтҍ чӯдтҍ чуэрьв вӯйев рыннҍтэ сыйе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Па̄рьн кӣчесьт тоагэ и мудта гоаррэ, кӣһч, штэ вӣдже элля ко̄з.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>Сонн воа̄льтэ самастрелэсь, пыйе нюл и тыввлувэ ре̄шшклэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>Чӯдтҍ чуэррьв поа̄ййнал ся̄мнесь, пэӆт па̄ррнэтҍ; анҍ па̄ррнэ поа̄ччкэв.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>Па̄рьн пые самастрелэсь со̄ннӭ раннҍтэ ди лӯшьтэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Тэль, чӯдтҍ чуэррьв ёрэ лӯвьт альн ерсайе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>А ныммьп пуадт и вӯйй и шӯррнаннт па̄рьн э̄л, штэ: «Мунн пуада, то̄н коанта, мэнн гуэйкэ муст тоа̄вврэж коанҍтэх.»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Па̄рьн апетҍ самастрелэсь пыйель нюл и нымьп ре̄шшкэль.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>И тэдт ёэ лӯвьт альн ерсайе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>Па̄ррьн кӣчесьт, касьт лӣ ныммьп па̄ррьн.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Ныммьп пе̄гач ю̄льк е̄в кӯнҍт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>Сонн, ця̄ӆӆк: «Вӣжь роастакэ ПАЛКА!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>Мэйт ёнах?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Быдт нарэдтӭ соа̄г лыһкэ».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>Па̄ррьн вӣджель паяс.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>А нарэдт пугк вуэсста.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Тамьпэ уййнэшь.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>Тэль и вӣже нарэдт пугк вуэсста.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Роадтҍешь вэ̄ннсэдэсь; вэ̄ннсэтҍ – ча̄дза ди суэллдэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>Тэль сугкэшь и э̄ллькэнҍ сӣнэтҍ оа̄рьегуэйм тагкэ и кэ̄лтэгуэйм ди пугк вэсстэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>Ни эххт эйй кӯдтҍеньч.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>О̄ллмэ куагкнэнҍ эвт сайя.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>Це̄ӆӆькэв: «Коххт, сыйй пугк пӯдтӭнҍ але е̄в пугк пуадтэньч?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Це̄ӆӆькэв: «Вӯллькэ, быдт о̄дзэ».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>Ну вот и вӯллькэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>Вӯллькэнҍ о̄дзэ о̄ллмнедтӭ лоагь мадтҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>А е̄ресь о̄ллмэ кӯдтҍенҍ вэ̄ннсатҍ, а тэгк вӯллькэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>А сӣнэсьт пысс еввлинньч.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>Толькэ эххт пысс-бякэньч.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>Сыйй воа̄ннҍцэнҍ-воа̄ннҍцэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Кӣһчев, кэ̄скэсьт по̄лльтэ куэсст сувв.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>Вот сыйй пӯдтӭнҍ алльтла.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>Кӣһчев сыйй, е̄ннэ-гэ лӣ о̄ллмнедтӭ тамьпэ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>Кӣһчев – эххт.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>Пӯдтӭнҍ алльтла.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>Сонн кыппт удт ди са̄ррн: «Кӣллт сӯлл альн куэсст рӯппьсесь пэ̄ллв»,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>– и са̄ррн: «Кӣлтэньч па̄ррнай вэ̄рр паянт».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>Тэгк е̄в кӣрршэньч, вэлльенҍ и роастак ТВОЮ…</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>«Мэнн са̄рнах?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>Сонн кӣчесьт – тэль пай са̄мь.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>Сонн юррьтэль, штэ са̄мь пӯдтӭнҍ, штэ со̄н нарэдт элля ӣльмэнҍ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Сонн вӣрэсьт удт, пӯллей вилка о̄йкэ ня̄ллма и тэйн роаһпад.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="rus" LINGUISTIC_TYPE_REF="ft-rus(orig)T"
        PARENT_REF="orth@ADD1854m" PARTICIPANT="ADD1854m" TIER_ID="ft-rus(orig)@ADD1854m">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a921" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>Как два подростка спасали народ (свой)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a922" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a923" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>Жил саамский народ на Кильдин-острове.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a924" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>Жили они за горой, не виднелась бы вторая половина.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a925" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>А лодки у них были возле берега.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a926" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>У них были лодки вытащены и были приклеплены в яму, не видно было бы на берег.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a927" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>Был праздник (выходной день).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a928" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Народу надо играть.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a929" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>Тот, другой – не идет караулить никто.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a931" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>Один парень говорит (скажет): „Я пойду, только мне товарища надо.“</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a932" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>Потом второй подросток (парень) нашелся.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a933" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>Вот они пришли на берег.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a934" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>Смотрят, не видно ничего.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a935" ANNOTATION_REF="a350">
                <ANNOTATION_VALUE>Потом они поползли на берег и стали играть.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a936" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>Стали играть и забылись.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a937" ANNOTATION_REF="a352">
                <ANNOTATION_VALUE>Играли, играли. Подросток хватился.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a938" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>Посмотрел, залив наиболее полон, плывут люди.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a939" ANNOTATION_REF="a354">
                <ANNOTATION_VALUE>Посмотрел, два разбойника плывут на берег к ним.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a940" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>Подросток посмотрел туда и в другую сторону, смотрит, что бежать некуда (не есть куда).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a941" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>Он взял самострел (свой), положил стрелу и приготовился стрелять.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a942" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>Разбойник поднимает бороду (свою), пугает ребят; пусть ребята убегут.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a943" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>Подросток положил (принцелился) самострел ему на грудь и спустил.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a944" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>Вот, разбойник упал на доске в сторону.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a945" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>И второй идет и плывет и грозится на парня, что я приду, я убью, почему у меня товарища убил.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a946" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>Подросток опять (в) самострел положил стрелу и вторично выстрелил.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a947" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a948" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>И тот свалился на доске в сторону.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a949" ANNOTATION_REF="a364">
                <ANNOTATION_VALUE>Подросток посмотрел, где (есть) другой парень.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a950" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>Второй ползет, ноги не несут.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a951" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>Он говорит (скажет): «Беги, растакая палка!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a953" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Почему падаешь?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a954" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>Надо народу весть дать (досл. – сделать)».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a955" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a956" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>Подросток побежал наверх.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a957" ANNOTATION_REF="a372">
                <ANNOTATION_VALUE>А народ весь навстречу.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a958" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>Там увидели.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a959" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>Вот и бежал народ весь навстречу.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a960" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>Сорвали лодки (свои); лодки – в воду и погребли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a961" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>Вот погребли и начали их (с) веслами бить и (с) палками и всех (все) перебили.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a962" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>Ни один не остался.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a963" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>Люди собрались в одно место.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a964" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>Говорят (скажут): «Как они все приходили или не все пришли?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a967" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>Говорят (скажут): «Итти надо искать».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a968" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>Ну вот и пошли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a969" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>Пошли искать человек десять.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a970" ANNOTATION_REF="a385">
                <ANNOTATION_VALUE>А прочие люди поставили лодки, а те пошли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a971" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>А у них ружей не было.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a972" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>Только одно ружьишко.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a973" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>Они шли-шли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a974" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>Смотрят посреди пахт виден дым.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a975" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>Вот они пришли ближе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a976" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>Смотрят они, много-ли (есть) людей там.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a977" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>Смотрят – один.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a978" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>Пришли (подошли) ближе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a979" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>Он варит кашу да говорит: «На Кильдин-острове видно красное облако»,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a982" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>и говорит: «Кильдинских ребят кровь поднимается».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a983" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>Те не стерпели, выскочили и растак твою…</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a984" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>«Что говоришь?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a985" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>Он (по)смотрит – вот все (суть) саамы.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a986" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>Он подумал, что саамы пришли потому, что его народ не есть в живых.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a987" ANNOTATION_REF="a402">
                <ANNOTATION_VALUE>Он помешал кашу, горячую вилку сунал в рот (свой) и (с) тем (от того) гибнет.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="rus" LINGUISTIC_TYPE_REF="ft-rusT"
        PARENT_REF="orth@ADD1854m" PARTICIPANT="ADD1854m" TIER_ID="ft-rus@ADD1854m">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a988" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>Как два подростка спасали свой народ.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a989" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a990" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>Жил саамский народ на Кильдинском острове.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a991" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>Жили они за горой, не виднелась бы вторая половина.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a992" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>А лодки у них были возле берега.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a993" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>У них были лодки вытащены и были приклеплены в яму, не видно было бы на берег.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a994" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>Был выходной день.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a995" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Народу надо играть.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a996" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>Тот, другой – не идет караулить никто.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a998" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>Один парень говорит: «Я пойду, только мне товарища надо.»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a999" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>Потом второй подросток нашелся.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1000" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>Вот они пришли на берег.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1001" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>Смотрят, не видно ничего.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1002" ANNOTATION_REF="a350">
                <ANNOTATION_VALUE>Потом они поползли на берег и стали играть.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1003" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>Стали играть и забылись.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1004" ANNOTATION_REF="a352">
                <ANNOTATION_VALUE>Играли-играли, подросток хватился.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1005" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>Посмотрел, залив наиболее полон, плывут люди.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1006" ANNOTATION_REF="a354">
                <ANNOTATION_VALUE>Посмотрел, два разбойника плывут на берег к ним.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1007" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>Подросток посмотрел туда и в другую сторону, смотрит, что бежать некуда.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1008" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>Он взял свой самострел, принцелился стрелу и приготовился стрелять.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1009" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>Разбойник поднимает свою бороду, пугает ребят; пусть ребята убегут.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1010" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>Подросток принцелился самострел ему на грудь и спустит.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1011" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>Вот, разбойник упал на доске в сторону.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1012" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>И второй идет и плывет и грозится на парня, что я приду, я убью, почему у меня товарища убил.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1013" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>Подросток опять в самострел положил стрелу и вторично выстрелил.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1014" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1015" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>И тот свалился на доске в сторону.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1016" ANNOTATION_REF="a364">
                <ANNOTATION_VALUE>Подросток посмотрел, где другой парень.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1017" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>Второй ползет, ноги не несут.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1018" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>Он, говорит: «Беги, растакая палка!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1020" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Почему падаешь?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1021" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>Надо народу весть дать».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1022" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1023" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>Подросток побежал наверх.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1024" ANNOTATION_REF="a372">
                <ANNOTATION_VALUE>А народ весь навстречу.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1025" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>Там увидели.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1026" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>Вот и бежал народ весь навстречу.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1027" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>Сорвали свои лодки; лодки – в воду и погребли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1028" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>Вот погребли и начали их с веслами бить и с палками и всех перебили.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1029" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>Ни один не остался.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1030" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>Люди собрались в одно место.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1031" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>Говорят: «Как они все приходили или не все пришли?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1034" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>Говорят: «Итти надо искать».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1035" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>Ну вот и пошли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1036" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>Пошли искать человек десять примерно.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1037" ANNOTATION_REF="a385">
                <ANNOTATION_VALUE>А прочие люди поставили лодки, а те пошли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1038" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>А у них ружей не было.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1039" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>Только одно ружьишко.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1040" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>Они шли-шли.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1041" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>Смотрят посреди пахт виден дым.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1042" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>Вот они пришли ближе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1043" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>Смотрят они, много-ли там людей.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1044" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>Смотрят – один.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1045" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>Пришли ближе.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1046" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>Он варит кашу да говорит: «На Кильдинском острове видно красное облако»,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1049" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>и говорит: «Кильдинских ребят кровь поднимается».</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1050" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>Те не стерпели, выскочили и растак твою…</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1051" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>«Что говоришь?»</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1052" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>Он смотрит – вот все (суть) саамы.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1053" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>Он подумал, что саамы пришли потому, что его народ не есть в живых.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1054" ANNOTATION_REF="a402">
                <ANNOTATION_VALUE>Он помешал кашу, горячую вилку сунал в рот и с этим гибнет.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft-lingT" PARENT_REF="orth@ADD1854m"
        PARTICIPANT="ADD1854m" TIER_ID="ft-ling@ADD1854m">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1055" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>partitive interesting syntaxt</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1056" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>partitive many, see Bible, perhaps not question particle</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LANG_REF="eng" LINGUISTIC_TYPE_REF="ft-engT"
        PARENT_REF="orth@ADD1854m" PARTICIPANT="ADD1854m" TIER_ID="ft-eng@ADD1854m">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1116" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>How two teenagers saved their people.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1117" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1118" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>The Saami people lived on Kildin Island.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1119" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>They lived beyond a mountain, and the other side could not be seen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1120" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>Their boats were near the shore.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1121" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>Their boats were pulled ashore and tied down in a hollow so they couldn’t be seen from the coast.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1122" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>It was a day off.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1123" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>People wanted to play.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1124" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>One or the other—no one wanted to stand guard.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1125" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>One boy said: “I’ll go, but I need a companion.”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1126" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>Then a second teenager was found.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1127" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>So they came to the shore.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1128" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>They looked—nothing was visible.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1129" ANNOTATION_REF="a350">
                <ANNOTATION_VALUE>Then they crawled up on the shore and began to play.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1130" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>They played and forgot themselves.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1131" ANNOTATION_REF="a352">
                <ANNOTATION_VALUE>They played and played, until one of the boys suddenly looked around.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1132" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>He looked—the bay was full, people were swimming.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1133" ANNOTATION_REF="a354">
                <ANNOTATION_VALUE>He saw that two robbers were swimming toward the shore where they were.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1134" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>The boy looked this way and that—there was nowhere to run.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1135" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>He took his crossbow, fitted an arrow, and prepared to shoot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1136" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>One of the robbers raised his beard and tried to scare the boys, so they would run away.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1137" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>The boy aimed the crossbow at his chest and fired.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1138" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>The robber fell sideways onto a plank.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1139" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>The second swam toward him, shouting threats: “I’ll come and kill you for killing my comrade!”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1140" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>The boy loaded another arrow into the crossbow and fired again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1141" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1142" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>And that one too fell sideways onto a plank.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1143" ANNOTATION_REF="a364">
                <ANNOTATION_VALUE>The boy looked around for the other lad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1144" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>The second was crawling; his legs wouldn’t carry him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1145" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>He said: “Run, you damned stick!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1146" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Why are you falling?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1147" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>We must tell the people the news.”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1148" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1149" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>The boy ran uphill.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1150" ANNOTATION_REF="a372">
                <ANNOTATION_VALUE>The people were already coming toward him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1151" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>They saw what had happened.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1152" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>So all the people ran to meet him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1153" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>They tore their boats loose, pushed them into the water, and began to row.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1154" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>They rowed to the robbers, beat them with oars and sticks, and killed them all.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1155" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>Not one remained alive.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1156" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>The people gathered in one place.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1157" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>They said: “Did they all come, or not all?”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1158" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>They said: “We must go look.”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1159" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>So they went.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1160" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>About ten people went to search.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1161" ANNOTATION_REF="a385">
                <ANNOTATION_VALUE>The others stayed behind with the boats while those ten went on.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1162" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>They had no guns.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1163" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>Only a single little gun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1164" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>They walked and walked.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1165" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>They saw smoke in the middle of the tundra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1166" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>They came closer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1167" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>They looked to see how many people were there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1168" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>They saw only one.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1169" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>They came closer still.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1170" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>He was cooking porridge and said: “A red cloud is visible over Kildin Island,”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1171" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>and said: “It’s the blood of the Kildin lads rising up.”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1172" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>They couldn’t restrain themselves, jumped out, and (shouted) “Damn your…!”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1173" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>“What did you say?”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1174" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>He looked and saw—they were all Saami.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1175" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>He thought the Saami had come because his people were no longer alive.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1176" ANNOTATION_REF="a402">
                <ANNOTATION_VALUE>He stirred the porridge, put the hot spoon into his mouth, and died on the spot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
