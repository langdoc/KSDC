            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1526" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>¶</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1527" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>Ӣле</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1528" ANNOTATION_REF="a338" PREVIOUS_ANNOTATION="a1527">
                <ANNOTATION_VALUE>са̄мь</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1529" ANNOTATION_REF="a338" PREVIOUS_ANNOTATION="a1528">
                <ANNOTATION_VALUE>нарэдт</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1530" ANNOTATION_REF="a338" PREVIOUS_ANNOTATION="a1529">
                <ANNOTATION_VALUE>кӣллт</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1531" ANNOTATION_REF="a338" PREVIOUS_ANNOTATION="a1530">
                <ANNOTATION_VALUE>сӯллэсьт</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1532" ANNOTATION_REF="a338" PREVIOUS_ANNOTATION="a1531">
                <ANNOTATION_VALUE>.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1533" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>Ӣлленҍ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1534" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1533">
                <ANNOTATION_VALUE>сыйй</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1535" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1534">
                <ANNOTATION_VALUE>па̄кь</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1536" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1535">
                <ANNOTATION_VALUE>тӯгкенҍ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1537" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1536">
                <ANNOTATION_VALUE>,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1538" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1537">
                <ANNOTATION_VALUE>эйй</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1539" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1538">
                <ANNOTATION_VALUE>куэстче</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1540" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1539">
                <ANNOTATION_VALUE>ныммьп</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1541" ANNOTATION_REF="a339" PREVIOUS_ANNOTATION="a1540">
